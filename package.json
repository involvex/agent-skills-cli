{
  "name": "@involvex/agent-skills-cli",
  "version": "1.1.4",
  "description": "Universal CLI for Agent Skills - works with 42 AI agents including Cursor, Claude Code, GitHub Copilot, Windsurf, Cline, Zed, and more. Supports private Git repos, npm packages, and enterprise configurations.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "skills": "./dist/cli/index.js",
    "agent-skills": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "build:fast": "tsup src/cli/index.ts src/index.ts --format esm --dts --clean --outDir dist",
    "dev": "bun run .\\src\\cli\\index.ts",
    "start": "node dist/cli/index.js",
    "test": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "agent-skills",
    "ai",
    "llm",
    "cursor",
    "claude-code",
    "github-copilot",
    "openai-codex",
    "skills",
    "marketplace",
    "private-git",
    "npm-packages",
    "bitbucket",
    "ssh",
    "enterprise",
    "skillsrc"
  ],
  "author": "Involvex",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/involvex/agent-skills-cli"
  },
  "homepage": "https://agentskills.in",
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@clack/prompts": "^1.0.1",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "glob": "^13.0.6",
    "gray-matter": "^4.0.3",
    "inquirer": "13.1.0",
    "ora": "^9.3.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/node": "20.19.27",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
